# API URL — required on Vercel. Example: https://lms-production-7308.up.railway.app
# /api is appended automatically when omitted from the path.
VITE_API_URL=https://lms-production-7308.up.railway.app

# Firebase (optional - for Firebase Auth)
# Get from Firebase Console > Project Settings > General > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

# Super admin (dev until API returns role)
# Comma-separated emails treated as superadmin on login
VITE_SUPERADMIN_EMAILS=
# Use localStorage mock for /superadmin/admins when backend is not ready
VITE_USE_MOCK_SUPERADMIN=false
